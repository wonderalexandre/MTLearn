PROJECT_NAME           = "MTLearn"
PROJECT_BRIEF          = "Public C++ API documentation"
OUTPUT_DIRECTORY       = "@MTLEARN_DOCS_PUBLIC_DIR@"

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api/index.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/api/cpp.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/api/python.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mtlearn/include/mtlearn"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api/index.md"

RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/mtlearn/include/mtlearn/detail"
EXCLUDE_PATTERNS       = */detail/* */internal/*
EXCLUDE_SYMBOLS        = mtlearn::morphology::detail::* \
                         std::*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
INTERNAL_DOCS          = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@MTLEARN_DOCS_PUBLIC_WARN_LOG@"
QUIET                  = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
