PROJECT_NAME           = "MTLearn"
PROJECT_BRIEF          = "Internal C++ contributor documentation"
OUTPUT_DIRECTORY       = "@MTLEARN_DOCS_INTERNAL_DIR@"

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mtlearn/include/mtlearn" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mtlearn/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/mtlearn/bindings"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api/index.md"

RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
INTERNAL_DOCS          = YES
ENABLED_SECTIONS       = INTERNAL
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@MTLEARN_DOCS_INTERNAL_WARN_LOG@"
QUIET                  = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
